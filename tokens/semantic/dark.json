{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "semantic": {
    "dark": {
      "$description": "Semantic aliases for the charcoal (dark) ground. v1.0.0.",
      "background": {
        "$value": "{color.ground.charcoal}",
        "$type": "color"
      },
      "text": {
        "$value": "{color.text.onCharcoal}",
        "$type": "color"
      },
      "muted": {
        "$value": "{color.grey.onCharcoal}",
        "$type": "color"
      },
      "accent": {
        "$value": "{color.accent.vermilion}",
        "$type": "color",
        "$description": "5.42:1 — unrestricted at any size on this ground."
      },
      "rule": {
        "$value": "{color.grey.onCharcoal}",
        "$type": "color",
        "$description": "Apply at alpha.hairline (0.22)."
      },
      "link": {
        "$value": "{color.link.onCharcoal}",
        "$type": "color",
        "$description": "Links only. Never a fill, rule, heading or CTA — vermilion keeps all of those."
      }
    }
  }
}
