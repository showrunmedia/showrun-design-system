{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "semantic": {
    "light": {
      "$description": "Semantic aliases for the paper (light) ground. v1.0.0.",
      "background": {
        "$value": "{color.ground.paper}",
        "$type": "color"
      },
      "text": {
        "$value": "{color.text.onPaper}",
        "$type": "color"
      },
      "muted": {
        "$value": "{color.grey.onPaper}",
        "$type": "color"
      },
      "accent": {
        "$value": "{color.accent.vermilion}",
        "$type": "color",
        "$description": "3.09:1 — AA-large. Navigational text only on this ground."
      },
      "rule": {
        "$value": "{color.grey.onPaper}",
        "$type": "color",
        "$description": "Apply at alpha.hairline (0.22)."
      }
    }
  }
}
